<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {# favicon "Video Center" : carré arrondi sombre + triangle lecture vert accent, remplace l'icône Symfony par défaut #}
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23141414'/%3E%3Cpath d='M12 9l12 7-12 7z' fill='%231DB954'/%3E%3C/svg%3E">

        {# Applique le thème mémorisé (localStorage) AVANT le chargement du CSS,
           pour éviter un flash visible du thème sombre par défaut suivi d'un
           bascule brutal vers le clair. Script minuscule et synchrone, exécuté
           avant tout le reste du <head>. data-bs-theme="dark" ci-dessus reste
           la valeur par défaut si JS est désactivé ou pour un nouveau visiteur. #}
        <script>
            (function () {
                try {
                    var saved = localStorage.getItem('theme');
                    if (saved === 'light' || saved === 'dark') {
                        document.documentElement.setAttribute('data-bs-theme', saved);
                    }
                } catch (e) {
                    // localStorage indisponible : on garde le thème sombre par défaut
                }
            })();
        </script>

        {% block stylesheets %}
            {# ajout de Bootstrap CSS via CDN #}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
            {# polices Google Fonts : Poppins pour les titres (identité forte), Inter pour le texte courant (lisibilité) #}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            {# ajout de Bootstrap JS (bundle avec Popper) via CDN #}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
    {% include 'layouts/partials/_nav.html.twig' %}

    {# affichage global des messages flash, quel que soit leur type (danger, success, info, etc.) #}
    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </div>

        {% block body %}{% endblock %}

    {% include 'layouts/partials/_footer.html.twig' %}
    </body>
</html>