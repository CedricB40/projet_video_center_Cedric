{% extends 'base.html.twig' %}

{% block title %}{{ 'videoEditTemplate.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row justify-content-center">
			<div
				class="col-md-6">
				{# colonne centrée, largeur limitée pour desktop #}

				<h1>{{ 'videoEditTemplate.title'|trans }}</h1>

				{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
				{# ouvre la balise form + désactive la validation native du navigateur et Turbo, pour laisser nos messages Symfony s'afficher #}
				{{ form_errors(form.title) }}
				{# erreurs spécifiques au champ titre #}
				{{ form_errors(form.videoLink) }}
				{# erreurs spécifiques au champ lien vidéo #}
				{{ form_errors(form.description) }}
				{# erreurs spécifiques au champ description #}
				{{ form_widget(form) }}
				{# affiche automatiquement tous les champs du formulaire #}

				<button type="submit" class="btn btn-primary mt-3">{{ 'videoEditTemplate.button'|trans }}</button>
				{# bouton de soumission Bootstrap #}

				{{ form_end(form) }}
				{# ferme le formulaire #}

			</div>
		</div>
	</div>
{% endblock %}