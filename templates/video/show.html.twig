{% extends 'base.html.twig' %}

{% block title %}
	{{ video.title }}
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row justify-content-center">
			<div
				class="col-md-8">
				{# colonne plus large que create/edit, pour laisser la place à l'iframe 640px #}

				<h1>
					{{ video.title }}
					{% if video.premiumVideo %}
						<span class="badge-premium badge-premium-inline">{{ 'videoBadge.premium'|trans }}</span>
					{% endif %}
				</h1>

				<iframe width="640" height="480" src="{{ video.videoLink }}" title="{{ video.title }}" frameborder="0" allowfullscreen></iframe>
				{# dimensions imposées par le PDF pour show #}

				<p class="mt-3">{{ video.description }}</p>
				{# description complète, non tronquée #}

				<p class="text-muted mb-1">
					<img src="{{ vich_uploader_asset(video.auteur, 'imageFile')|imagine_filter('user_thumbnail') }}" alt="{{ video.auteur.firstname }}" width="24" height="24" class="rounded-circle">
					{{ 'showTemplate.author'|trans }} {{ video.auteur.firstname }} {{ video.auteur.lastname }}</p>
				{# nom et photo de l'auteur, exigés par le cahier des charges #}

				<p class="text-muted">{{ 'showTemplate.publishedOn'|trans }}
					{{ video.createdAt|date('d/m/Y à H:i') }}</p>
				{# formatage de la date via le filtre |date #}

				<a href="{{ path('app_home') }}" class="btn btn-secondary">{{ 'showTemplate.back'|trans }}</a>
				{# lien vers l'accueil via le nom de route, jamais l'URL en dur #}
				{% if app.user == video.auteur %}
					<a href="{{ path('app_video_edit', {id: video.id}) }}" class="btn btn-warning">{{ 'showTemplate.edit'|trans }}</a>
					{# lien vers l'édition de cette vidéo précise #}

					{# formulaire POST requis pour la suppression ; confirmation via confirm() natif du navigateur (plus simple et fiable que la modale Bootstrap) #}
					<form method="post" action="{{ path('app_video_delete', {id: video.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'showTemplate.confirmDelete'|trans|e('js') }}');">
						<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ video.id) }}">
						{# token CSRF, doit correspondre à la clé utilisée dans le contrôleur #}
						<button type="submit" class="btn btn-danger">{{ 'showTemplate.delete'|trans }}</button>
					</form>
				{% endif %}

			</div>
		</div>
	</div>
{% endblock %}