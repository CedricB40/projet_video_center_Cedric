{% extends 'base.html.twig' %}

{% block title %}{{ 'homeTemplate.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<h1>{{ 'homeTemplate.title'|trans }}</h1>

		{% if app.user %}
			{# barre de recherche visible uniquement si connecté, imposé par le cahier des charges #}
			<form method="get" action="{{ path('app_home') }}" class="mb-3">
				<div class="input-group">
					<input type="text" name="search" class="form-control" placeholder="{{ 'homeTemplate.searchPlaceholder'|trans }}" value="{{ search }}">
					<button class="btn btn-primary" type="submit">{{ 'homeTemplate.searchButton'|trans }}</button>
				</div>
			</form>

			{% if search %}
				{# compteur affiché uniquement si une recherche est active #}
				<p>{{ 'homeTemplate.searchResults'|trans({'%count%': videos.getTotalItemCount(), '%term%': search}) }}</p>
			{% endif %}
		{% endif %}

		<div class="row">
			{% for video in videos %}
				{# boucle sur toutes les vidéos envoyées par le contrôleur #}
				<div
					class="col-md-4 mb-4">
					{# 3 vidéos par ligne sur desktop #}
					<div class="card{% if video.premiumVideo %} card-premium{% endif %}">
						{# bordure dorée ajoutée aux vidéos premium pour les repérer d'un coup d'œil #}
						<div class="card-body">
							<h5 class="card-title">
								<a href="{{ path('app_video_show', {id: video.id}) }}">
									{# lien cliquable vers show #}
									{{ video.title|u.truncate(20, '...', true) }}
									{# titre tronqué à 20 caractères #}
								</a>
							</h5>
							<div class="position-relative d-inline-block">
								{% if video.premiumVideo %}
									<span class="badge-premium">{{ 'videoBadge.premium'|trans }}</span>
								{% endif %}
								<iframe width="300" height="200" src="{{ video.videoLink }}" title="{{ video.title }}" frameborder="0" allowfullscreen></iframe>
								{# dimensions imposées pour index #}
							</div>
							<p class="card-text mt-2">{{ video.description|u.truncate(25, '...', true) }}</p>
							{# description tronquée à 25 caractères #}
							<p class="text-muted small mb-1">
								<img src="{{ vich_uploader_asset(video.auteur, 'imageFile')|imagine_filter('user_thumbnail') }}" alt="{{ video.auteur.firstname }}" width="24" height="24" class="rounded-circle">
								{{ 'homeTemplate.author'|trans }} {{ video.auteur.firstname }} {{ video.auteur.lastname }}</p>
							{# nom et photo de l'auteur, exigés par le cahier des charges #}
							<p class="text-muted small">{{ 'homeTemplate.uploaded'|trans }}
								{{ video.createdAt|ago }}</p>
							{# temps écoulé depuis la publication, via KnpTimeBundle #}
						</div>
					</div>
				</div>
			{% else %}
				{# état vide plus travaillé qu'un simple texte : icône + message, affiché si la boucle for n'a rien à itérer #}
				<div class="empty-state">
					<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path><path d="M8 11h6"></path></svg>
					<p>{{ 'homeTemplate.noResults'|trans }}</p>
				</div>
			{% endfor %}
		</div>
	</div>
	<div class="d-flex justify-content-center mt-4">
		{{ knp_pagination_render(videos) }}
	</div>
{% endblock %}