{# dis à twig  qu'il hérite de base.html.twig #}
{% extends 'base.html.twig' %}

{# remplis le bloc titre #}
{% block title %}Créer une vidéo
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-6"> {# colonne centrée, largeur limitée pour desktop #}

				<h1>Créer une vidéo</h1> 

				{{ form_start(form) }} {# ouvre la balise form avec token CSRF automatique #}
				{{ form_widget(form) }} {# affiche automatiquement tous les champs du formulaire #}

				<button type="submit" class="btn btn-primary mt-3">Créer</button> {# bouton de soumission Bootstrap #}

				{{ form_end(form) }} {# ferme le formulaire #}

			</div>
		</div>
	</div>
{% endblock %}