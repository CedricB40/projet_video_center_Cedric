{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-md-6">
				<form method="post">
					{% if error %}
						<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
					{% endif %}

					{% if app.user %}
						<div class="mb-3">
							{{ 'loginTemplate.connectedAs'|trans }}
							{{ app.user.userIdentifier }},
							<a href="{{ logout_path() }}">{{ 'loginTemplate.logout'|trans }}</a>
						</div>
					{% endif %}

					<h1 class="h3 mb-3 font-weight-normal">{{ 'loginTemplate.title'|trans }}</h1>
					<label for="username">{{ 'loginTemplate.email'|trans }}</label>
					<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
					<label for="password">{{ 'loginTemplate.password'|trans }}</label>
					<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
					<input
					type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

					{#
									            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
									            See https://symfony.com/doc/current/security/remember_me.html
									
									            <div class="checkbox mb-3">
									                <input type="checkbox" name="_remember_me" id="_remember_me">
									                <label for="_remember_me">Se souvenir de moi</label>
									            </div>
									        #}

					<a href="{{ path('app_forgot_password_request') }}">{{ 'loginTemplate.forgotPassword'|trans }}</a>
					<button class="btn btn-lg btn-primary mt-3" type="submit">
						{{ 'loginTemplate.button'|trans }}
					</button>
				</form>
				<p class="text-center mt-3">{{ 'loginTemplate.notRegistered'|trans }} <a href="{{ path('app_register') }}">{{ 'loginTemplate.createAccount'|trans }}</a></p>
			</div>
		</div>
	</div>
{% endblock %}