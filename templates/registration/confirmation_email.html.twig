<h1>{{ 'confirmationEmail.greeting'|trans }}</h1>

<p>
    {{ 'confirmationEmail.body'|trans }} <br><br>
    <a href="{{ signedUrl|raw }}">{{ 'confirmationEmail.link'|trans }}</a>.
    {{ 'confirmationEmail.expiresIn'|trans }} {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
</p>

<p>
    {{ 'confirmationEmail.signature'|trans }}
</p>