{% extends 'base.html.twig' %}

{% block title %}{{ 'errorTemplate.404Title'|trans }}{% endblock %}

{% block body %}
    <div class="error-page">
        <div class="error-code">404</div>
        <h1>{{ 'errorTemplate.404Title'|trans }}</h1>
        <p>{{ 'errorTemplate.404Message'|trans }}</p>
        <a href="{{ path('app_home') }}" class="btn btn-primary">{{ 'errorTemplate.backHome'|trans }}</a>
    </div>
{% endblock %}
