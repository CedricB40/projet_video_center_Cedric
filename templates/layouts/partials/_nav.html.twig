{# distingue 3 états — non connecté, connecté non vérifié, connecté et vérifié (accès à "Créer une vidéo" réservé aux vérifiés). #}
<nav class="navbar navbar-expand-sm navbar-dark bg-dark">
	<div class="container-fluid">
		<a class="navbar-brand" href="{{ path('app_home') }}">Video Center</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarNav">
			<ul class="navbar-nav me-auto mb-2 mb-sm-0">
				<li class="nav-item">
					<a class="nav-link" href="{{ path('app_home') }}">{{ 'navBar.home'|trans }}</a>
				</li>
			</ul>
			<ul class="navbar-nav">
				{% if app.user %}
					{% if app.user.isVerified %}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_video_create') }}">{{ 'navBar.createVideo'|trans }}</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_account') }}">{{ 'navBar.account'|trans }}</a>
						</li>
					{% endif %}
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_logout') }}">{{ 'navBar.logout'|trans }}</a>
					</li>
				{% else %}
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_register') }}">{{ 'navBar.register'|trans }}</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_login') }}">{{ 'navBar.login'|trans }}</a>
					</li>
				{% endif %}
				<li class="nav-item d-flex align-items-center ms-2">
					{% if app.request.locale == 'fr' %}
						<span class="nav-link text-white fw-bold">FR</span>
					{% else %}
						<a class="nav-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}">FR</a>
					{% endif %}
					<span class="text-white-50">|</span>
					{% if app.request.locale == 'en' %}
						<span class="nav-link text-white fw-bold">EN</span>
					{% else %}
						<a class="nav-link" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}">EN</a>
					{% endif %}
				</li>
				<li class="nav-item d-flex align-items-center ms-2">
					{# bouton de bascule thème sombre/clair : le contrôleur Stimulus "theme" gère le clic
					   et la mémorisation (localStorage), le CSS se charge d'afficher la bonne icône selon
					   l'attribut data-bs-theme posé sur <html> #}
					<button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle" aria-label="Changer de thème">
						<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
						<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					</button>
				</li>
			</ul>
		</div>
	</div>
</nav>