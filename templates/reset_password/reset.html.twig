{% extends 'base.html.twig' %}

{% block title %}{{ 'resetPasswordTemplate.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'resetPasswordTemplate.title'|trans }}</h1>

    {{ form_start(resetForm, {'attr': {'data-turbo': 'false'}}) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="btn btn-primary">{{ 'resetPasswordTemplate.button'|trans }}</button>
    {{ form_end(resetForm) }}
{% endblock %}