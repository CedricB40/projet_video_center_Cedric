{% extends 'base.html.twig' %}

{% block title %}{{ 'resetPasswordTemplate.title'|trans }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1>{{ 'resetPasswordTemplate.title'|trans }}</h1>

                {{ form_start(resetForm, {'attr': {'data-turbo': 'false'}}) }}
                    {{ form_row(resetForm.plainPassword) }}
                    <button class="btn btn-primary mt-3">{{ 'resetPasswordTemplate.button'|trans }}</button>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </div>
{% endblock %}