{% extends 'base.html.twig' %}

{% block title %}{{ 'checkEmailTemplate.title'|trans }}{% endblock %}

{% block body %}
    <p>
        {{ 'checkEmailTemplate.body'|trans }} {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>
    <p>{{ 'checkEmailTemplate.noEmail'|trans }} <a href="{{ path('app_forgot_password_request') }}">{{ 'checkEmailTemplate.retry'|trans }}</a>.</p>
{% endblock %}