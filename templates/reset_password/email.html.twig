<h1>{{ 'resetPasswordEmail.greeting'|trans }}</h1>

<p>{{ 'resetPasswordEmail.body'|trans }}</p>

<a href="{{ url('app_reset_password', {token: resetToken.token}) }}">{{ url('app_reset_password', {token: resetToken.token}) }}</a>

<p>{{ 'resetPasswordEmail.expiresIn'|trans }} {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.</p>

<p>{{ 'resetPasswordEmail.signature'|trans }}</p>