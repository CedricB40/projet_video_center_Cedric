{% extends 'base.html.twig' %}

{% block title %}Mon profil
{% endblock %}

{% block body %}
	<div class="container">
		<h1>Mon profil</h1>

		{# imagine_filter applique le filtre user_thumbnail défini dans liip_imagine.yaml (150x150px, recadré) #}
		<img src="{{ vich_uploader_asset(user, 'imageFile')|imagine_filter('user_thumbnail') }}">
		<p>
			<strong>Email :</strong>
			{{ user.email }}</p>
		<p>
			<strong>Prénom :</strong>
			{{ user.firstname }}</p>
		<p>
			<strong>Nom :</strong>
			{{ user.lastname }}</p>
		{# format jour/mois/année plutôt que le format ISO par défaut de DateTimeImmutable #}
		<p>
			<strong>Membre depuis :</strong>
			{{ user.createdAt|date('d/m/Y') }}</p>
	</div>
{% endblock %}
