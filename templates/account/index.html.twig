{% extends 'base.html.twig' %}

{% block title %}{{ 'accountTemplate.title'|trans }}
{% endblock %}

{% block body %}
	<div class="container">
		<h1>{{ 'accountTemplate.title'|trans }}</h1>

		{# imagine_filter applique le filtre user_thumbnail défini dans liip_imagine.yaml (150x150px, recadré) #}
		<img src="{{ vich_uploader_asset(user, 'imageFile')|imagine_filter('user_thumbnail') }}" alt="{{ user.firstname }}" class="rounded-circle profile-avatar mb-3">
		<p>
			<strong>{{ 'accountTemplate.email'|trans }}</strong>
			{{ user.email }}</p>
		<p>
			<strong>{{ 'accountTemplate.firstname'|trans }}</strong>
			{{ user.firstname }}</p>
		<p>
			<strong>{{ 'accountTemplate.lastname'|trans }}</strong>
			{{ user.lastname }}</p>
		{# format jour/mois/année plutôt que le format ISO par défaut de DateTimeImmutable #}
		<p>
			<strong>{{ 'accountTemplate.memberSince'|trans }}</strong>
			{{ user.createdAt|date('d/m/Y') }}</p>

		<a href="{{ path('app_account_edit') }}" class="btn btn-primary mb-4">{{ 'accountTemplate.editProfile'|trans }}</a>

		<h2>{{ 'accountTemplate.myVideos'|trans }}</h2>

		<div class="row">
			{% for video in videos %}
				{# boucle sur toutes les vidéos de l'utilisateur connecté, envoyées par le contrôleur via user.getVideos() #}
				<div
					class="col-md-4 mb-4">
					{# 3 vidéos par ligne sur desktop, cohérent avec video/index.html.twig #}
					<div class="card{% if video.premiumVideo %} card-premium{% endif %}">
						{# bordure dorée pour repérer les vidéos premium, cohérent avec video/index.html.twig #}
						<div class="card-body">
							<h5 class="card-title">
								<a href="{{ path('app_video_show', {id: video.id}) }}">
									{# lien cliquable vers show #}
									{{ video.title|u.truncate(20, '...', true) }}
									{# titre tronqué à 20 caractères #}
								</a>
							</h5>
							<div class="position-relative d-inline-block">
								{% if video.premiumVideo %}
									<span class="badge-premium">{{ 'videoBadge.premium'|trans }}</span>
								{% endif %}
								<iframe width="300" height="200" src="{{ video.videoLink }}" title="{{ video.title }}" frameborder="0" allowfullscreen></iframe>
								{# dimensions imposées pour index #}
							</div>
							<p class="card-text mt-2">{{ video.description|u.truncate(25, '...', true) }}</p>
							{# description tronquée à 25 caractères #}
							<p class="text-muted small">{{ 'homeTemplate.uploaded'|trans }}
								{{ video.createdAt|ago }}</p>
							{# temps écoulé depuis la publication, via KnpTimeBundle, clé réutilisée depuis index #}
						</div>
					</div>
				</div>
			{% else %}
				{# état vide, cohérent avec celui de video/index.html.twig #}
				<div class="empty-state">
					<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="15" height="12" rx="2"></rect><path d="M22 8.5l-5 3.5 5 3.5v-7z"></path></svg>
					<p>{{ 'accountTemplate.noVideos'|trans }}</p>
				</div>
			{% endfor %}
		</div>
	</div>
{% endblock %}