{% extends 'base.html.twig' %}

{% block title %}{{ 'accountEditTemplate.title'|trans }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>{{ 'accountEditTemplate.title'|trans }}</h1>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
                {{ form_errors(form.firstname) }}
                {{ form_errors(form.lastname) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-primary mt-3">{{ 'accountEditTemplate.saveButton'|trans }}</button>
                <a href="{{ path('app_account') }}" class="btn btn-secondary mt-3">{{ 'accountEditTemplate.backButton'|trans }}</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}